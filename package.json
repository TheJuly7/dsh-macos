{
  "name": "dsh-macos",
  "version": "1.2.2",
  "description": "Makes the DeepSeek Harness desktop client on Windows look and behave like the macOS build: traffic lights, a collapsible frosted sidebar, a flush seam between the two parts, and no caption buttons.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheJuly7/dsh-macos.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "macos",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "meta": {
    "title": "macOS Shell",
    "description": "Traffic lights, a frosted sidebar and no caption buttons: the macOS client, on Windows."
  },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "surface",
    "tools",
    "verify.mjs",
    "install.cmd",
    "uninstall.cmd",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node tools/install.mjs",
    "teardown": "node tools/install.mjs --remove",
    "verify": "node verify.mjs",
    "surface": "node tools/extract-dsh-surface.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}


